# Salin menjadi .env (jangan di-commit).
# Lokasi database SQLite (default: data/nota.db)
NOTA_DB=data/nota.db
# Windows: lokasi tesseract.exe bila tidak ada di PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Hanya untuk mesin Claude vision
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
